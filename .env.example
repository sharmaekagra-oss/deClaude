# Copy this file to .env.local and fill in your own key(s). Never commit .env.local.
# Set at least one key. With both set, Claude is used unless PROVIDER=gemini.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Optional: providers to try, in order, e.g. gemini,openrouter
PROVIDER=
# Optional model overrides (defaults: claude-opus-5-5, gemini-3.8-flash)
CLAUDE_MODEL=
GEMINI_MODEL=
# Optional shared passcode so only classmates can use the live app
APP_PASSCODE=
